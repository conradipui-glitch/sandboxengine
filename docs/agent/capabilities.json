{
  "contractsSchemaVersion": "1.0",
  "blockKinds": [
    "core.character",
    "core.location",
    "core.resource"
  ],
  "gameplayEffectTypes": [
    "entity.move",
    "item.transfer",
    "resource.change"
  ],
  "conditionTypes": [
    "all",
    "any",
    "entity.at",
    "item.heldBy",
    "not",
    "resource.atLeast"
  ],
  "socialActTypes": [
    "permission",
    "request",
    "response"
  ],
  "scheduledEventKinds": [
    "core.effects",
    "core.marker",
    "core.terminal"
  ],
  "scheduledTaskKinds": [
    "core.task"
  ],
  "actionTypes": [
    "core.paint",
    "core.social.permission",
    "core.social.request",
    "core.social.response"
  ],
  "operations": [
    {
      "id": "runtime.healthz",
      "method": "GET",
      "path": "/healthz",
      "summary": "Проверка доступности Runtime API",
      "successStatus": 200
    },
    {
      "id": "runtime.sessions.create",
      "method": "POST",
      "path": "/v1/sessions",
      "summary": "Создание гостевой игровой сессии",
      "successStatus": 201
    },
    {
      "id": "runtime.sessions.get",
      "method": "GET",
      "path": "/v1/sessions/{sessionId}",
      "summary": "Получение player-safe состояния своей игровой сессии",
      "successStatus": 200
    },
    {
      "id": "runtime.sessions.action",
      "method": "POST",
      "path": "/v1/sessions/{sessionId}/actions",
      "summary": "Отправка одного поддержанного explicit игрового действия",
      "successStatus": 200
    },
    {
      "id": "runtime.operations.get",
      "method": "GET",
      "path": "/v1/sessions/{sessionId}/operations/{operationId}",
      "summary": "Восстановление публичного статуса или результата операции",
      "successStatus": 200
    }
  ]
}
