  "operations": [
    {
      "id": "runtime.healthz",
      "method": "GET",
      "path": "/healthz",
      "summary": "Проверка доступности Runtime API",
      "successStatus": 200
    },
    {
      "id": "runtime.sessions.create",
      "method": "POST",
      "path": "/v1/sessions",
      "summary": "Создание гостевой игровой сессии",
      "successStatus": 201
    },
    {
      "id": "runtime.sessions.get",
      "method": "GET",
      "path": "/v1/sessions/{sessionId}",
      "summary": "Получение player-safe состояния своей игровой сессии",
      "successStatus": 200
    },
    {
      "id": "runtime.sessions.action",
      "method": "POST",
      "path": "/v1/sessions/{sessionId}/actions",
      "summary": "Отправка одного поддержанного explicit игрового действия",
      "successStatus": 200
    },
    {
      "id": "runtime.operations.get",
      "method": "GET",
      "path": "/v1/sessions/{sessionId}/operations/{operationId}",
      "summary": "Восстановление публичного статуса или результата операции",
      "successStatus": 200
    },
    {
      "id": "control.auth.login",
      "method": "POST",
      "path": "/control/v1/auth/login",
      "summary": "Вход закрытого Control-пользователя и выдача серверной сессии с CSRF proof",
      "successStatus": 200
    },
    {
      "id": "control.auth.session",
      "method": "GET",
      "path": "/control/v1/auth/session",
      "summary": "Получение безопасных метаданных текущей Control-сессии",
      "successStatus": 200
    },
    {
      "id": "control.auth.logout",
      "method": "POST",
      "path": "/control/v1/auth/logout",
      "summary": "CSRF-защищённый отзыв текущей Control-сессии",
      "successStatus": 200
    },
    {
      "id": "control.projects.list",
      "method": "GET",
      "path": "/control/v1/projects",
      "summary": "Список доступных текущему автору проектов",
      "successStatus": 200
    },
    {
      "id": "control.projects.create",
      "method": "POST",
      "path": "/control/v1/projects",
      "summary": "Создание авторского проекта; в authenticated mode создатель атомарно становится owner",
      "successStatus": 201
    },
    {
      "id": "control.members.list",
      "method": "GET",
      "path": "/control/v1/projects/{projectId}/members",
      "summary": "Owner-only список участников проекта и ролей",
      "successStatus": 200
    },
    {
      "id": "control.members.update",
      "method": "PUT",
      "path": "/control/v1/projects/{projectId}/members/{userId}",
      "summary": "Owner-only назначение роли owner/editor/tester существующему закрытому пользователю",
      "successStatus": 200
    },
    {
      "id": "control.members.delete",
      "method": "DELETE",
      "path": "/control/v1/projects/{projectId}/members/{userId}",
      "summary": "Owner-only удаление участника с защитой последнего owner",
      "successStatus": 200
    },
    {
      "id": "control.quests.list",
      "method": "GET",
      "path": "/control/v1/projects/{projectId}/quests",
      "summary": "Список квестов доступного проекта и текущих draft revisions",
      "successStatus": 200
    },
    {
      "id": "control.quests.create",
      "method": "POST",
      "path": "/control/v1/projects/{projectId}/quests",
      "summary": "Owner/editor создание квеста с начальным draft snapshot",
      "successStatus": 201
    },
    {
      "id": "control.draft.get",
      "method": "GET",
      "path": "/control/v1/projects/{projectId}/quests/{questId}/draft",
      "summary": "Получение текущего авторского draft snapshot доступного проекта",
      "successStatus": 200
    },
    {
      "id": "control.draft.changes",
      "method": "POST",
      "path": "/control/v1/projects/{projectId}/quests/{questId}/draft/changes",
      "summary": "Owner/editor атомарное применение change set к указанной draft revision",
      "successStatus": 200
    },
    {
      "id": "control.draft.history",
      "method": "GET",
      "path": "/control/v1/projects/{projectId}/quests/{questId}/draft/history",
      "summary": "Постраничная история immutable draft revisions доступного проекта",
      "successStatus": 200
    },
    {
      "id": "control.draft.compare",
      "method": "GET",
      "path": "/control/v1/projects/{projectId}/quests/{questId}/draft/compare",
      "summary": "Серверное сравнение двух конкретных draft revisions без автоматического merge",
      "successStatus": 200
    },
    {
      "id": "control.draft.references",
      "method": "GET",
      "path": "/control/v1/projects/{projectId}/quests/{questId}/draft/references",
      "summary": "Typed preflight зависимостей блока и объяснение безопасности удаления",
      "successStatus": 200
    },
    {
      "id": "control.draft.restore",
      "method": "POST",
      "path": "/control/v1/projects/{projectId}/quests/{questId}/draft/restore",
      "summary": "Owner/editor idempotent восстановление прошлой revision как новой revision по baseRevision CAS",
      "successStatus": 201
    },
    {
      "id": "control.quest.clone",
      "method": "POST",
      "path": "/control/v1/projects/{projectId}/quests/{sourceQuestId}/clone",
      "summary": "Owner/editor idempotent clone текущего source draft в независимый quest с remap внутренних block IDs",
      "successStatus": 201
    },
    {
      "id": "control.quest.export",
      "method": "GET",
      "path": "/control/v1/projects/{projectId}/quests/{questId}/export",
      "summary": "Owner/editor экспорт точной immutable draft revision как deterministic inert .lhquest.zip package",
      "successStatus": 200
    },
    {
      "id": "control.imports.create",
      "method": "POST",
      "path": "/control/v1/projects/{projectId}/imports",
      "summary": "Owner/editor bounded fail-closed import .lhquest.zip в новый unpublished quest draft",
      "successStatus": 201
    },
    {
      "id": "control.validations.create",
      "method": "POST",
      "path": "/control/v1/projects/{projectId}/quests/{questId}/validations",
      "summary": "Проверка конкретной draft revision участником проекта и фиксация immutable report",
      "successStatus": 201
    },
    {
      "id": "control.playtests.create",
      "method": "POST",
      "path": "/control/v1/projects/{projectId}/quests/{questId}/playtests",
      "summary": "Создание frozen playtest участником проекта из проверенного draft snapshot",
      "successStatus": 201
    },
    {
      "id": "control.playtests.get",
      "method": "GET",
      "path": "/control/v1/projects/{projectId}/quests/{questId}/playtests/{playtestId}",
      "summary": "Чтение безопасных метаданных frozen playtest доступного проекта",
      "successStatus": 200
    },
    {
      "id": "control.releases.list",
      "method": "GET",
      "path": "/control/v1/projects/{projectId}/quests/{questId}/releases",
      "summary": "Чтение immutable release summaries, current pointer и publication status участником проекта",
      "successStatus": 200
    },
    {
      "id": "control.releases.create",
      "method": "POST",
      "path": "/control/v1/projects/{projectId}/quests/{questId}/releases",
      "summary": "Owner/editor сборка immutable release из точной успешной validation и compiled artifact hash",
      "successStatus": 201
    },
    {
      "id": "control.publish",
      "method": "POST",
      "path": "/control/v1/projects/{projectId}/quests/{questId}/publish",
      "summary": "Owner-only атомарная публикация совместимого release через expected-current compare-and-set",
      "successStatus": 200
    },
    {
      "id": "control.rollback",
      "method": "POST",
      "path": "/control/v1/projects/{projectId}/quests/{questId}/rollback",
      "summary": "Owner-only pointer rollback к ранее опубликованному release через expected-current compare-and-set",
      "successStatus": 200
    }
  ]
}
