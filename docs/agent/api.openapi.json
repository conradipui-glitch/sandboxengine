{
  "openapi": "3.1.1",
  "info": {
    "title": "Living History Engine API",
    "version": "0.1.0"
  },
  "paths": {
    "/healthz": {
      "get": {
        "operationId": "runtime_healthz",
        "summary": "Проверка доступности Runtime API",
        "responses": {
          "200": {
            "description": "Successful response"
          }
        }
      }
    },
    "/v1/sessions": {
      "post": {
        "operationId": "runtime_sessions_create",
        "summary": "Создание гостевой игровой сессии",
        "responses": {
          "201": {
            "description": "Successful response"
          }
        }
      }
    },
    "/v1/sessions/{sessionId}": {
      "get": {
        "operationId": "runtime_sessions_get",
        "summary": "Получение player-safe состояния своей игровой сессии",
        "responses": {
          "200": {
            "description": "Successful response"
          }
        }
      }
    },
    "/v1/sessions/{sessionId}/actions": {
      "post": {
        "operationId": "runtime_sessions_action",
        "summary": "Отправка одного поддержанного explicit игрового действия",
        "responses": {
          "200": {
            "description": "Successful response"
          }
        }
      }
    },
    "/v1/sessions/{sessionId}/operations/{operationId}": {
      "get": {
        "operationId": "runtime_operations_get",
        "summary": "Восстановление публичного статуса или результата операции",
        "responses": {
          "200": {
            "description": "Successful response"
          }
        }
      }
    },
    "/control/v1/auth/login": {
      "post": {
        "operationId": "control_auth_login",
        "summary": "Вход закрытого Control-пользователя и выдача серверной сессии с CSRF proof",
        "responses": {
          "200": {
            "description": "Successful response"
          }
        }
      }
    },
    "/control/v1/auth/session": {
      "get": {
        "operationId": "control_auth_session",
        "summary": "Получение безопасных метаданных текущей Control-сессии",
        "responses": {
          "200": {
            "description": "Successful response"
          }
        }
      }
    },
    "/control/v1/auth/logout": {
      "post": {
        "operationId": "control_auth_logout",
        "summary": "CSRF-защищённый отзыв текущей Control-сессии",
        "responses": {
          "200": {
            "description": "Successful response"
          }
        }
      }
    },
    "/control/v1/projects": {
      "get": {
        "operationId": "control_projects_list",
        "summary": "Список доступных текущему автору проектов",
        "responses": {
          "200": {
            "description": "Successful response"
          }
        }
      },
      "post": {
        "operationId": "control_projects_create",
        "summary": "Создание авторского проекта; в authenticated mode создатель атомарно становится owner",
        "responses": {
          "201": {
            "description": "Successful response"
          }
        }
      }
    },
    "/control/v1/projects/{projectId}/members": {
      "get": {
        "operationId": "control_members_list",
        "summary": "Owner-only список участников проекта и ролей",
        "responses": {
          "200": {
            "description": "Successful response"
          }
        }
      }
    },
    "/control/v1/projects/{projectId}/members/{userId}": {
      "put": {
        "operationId": "control_members_update",
        "summary": "Owner-only назначение роли owner/editor/tester существующему закрытому пользователю",
        "responses": {
          "200": {
            "description": "Successful response"
          }
        }
      },
      "delete": {
        "operationId": "control_members_delete",
        "summary": "Owner-only удаление участника с защитой последнего owner",
        "responses": {
          "200": {
            "description": "Successful response"
          }
        }
      }
    },
    "/control/v1/projects/{projectId}/quests": {
      "get": {
        "operationId": "control_quests_list",
        "summary": "Список квестов доступного проекта и текущих draft revisions",
        "responses": {
          "200": {
            "description": "Successful response"
          }
        }
      },
      "post": {
        "operationId": "control_quests_create",
        "summary": "Owner/editor создание квеста с начальным draft snapshot",
        "responses": {
          "201": {
            "description": "Successful response"
          }
        }
      }
    },
    "/control/v1/projects/{projectId}/quests/{questId}/draft": {
      "get": {
        "operationId": "control_draft_get",
        "summary": "Получение текущего авторского draft snapshot доступного проекта",
        "responses": {
          "200": {
            "description": "Successful response"
          }
        }
      }
    },
    "/control/v1/projects/{projectId}/quests/{questId}/draft/changes": {
      "post": {
        "operationId": "control_draft_changes",
        "summary": "Owner/editor атомарное применение change set к указанной draft revision",
        "responses": {
          "200": {
            "description": "Successful response"
          }
        }
      }
    },
    "/control/v1/projects/{projectId}/quests/{questId}/draft/history": {
      "get": {
        "operationId": "control_draft_history",
        "summary": "Постраничная история immutable draft revisions доступного проекта",
        "responses": {
          "200": {
            "description": "Successful response"
          }
        }
      }
    },
    "/control/v1/projects/{projectId}/quests/{questId}/draft/compare": {
      "get": {
        "operationId": "control_draft_compare",
        "summary": "Серверное сравнение двух конкретных draft revisions без автоматического merge",
        "responses": {
          "200": {
            "description": "Successful response"
          }
        }
      }
    },
    "/control/v1/projects/{projectId}/quests/{questId}/draft/references": {
      "get": {
        "operationId": "control_draft_references",
        "summary": "Typed preflight зависимостей блока и объяснение безопасности удаления",
        "responses": {
          "200": {
            "description": "Successful response"
          }
        }
      }
    },
    "/control/v1/projects/{projectId}/quests/{questId}/draft/restore": {
      "post": {
        "operationId": "control_draft_restore",
        "summary": "Owner/editor idempotent восстановление прошлой revision как новой revision по baseRevision CAS",
        "responses": {
          "201": {
            "description": "Successful response"
          }
        }
      }
    },
    "/control/v1/projects/{projectId}/quests/{sourceQuestId}/clone": {
      "post": {
        "operationId": "control_quest_clone",
        "summary": "Owner/editor idempotent clone текущего source draft в независимый quest с remap внутренних block IDs",
        "responses": {
          "201": {
            "description": "Successful response"
          }
        }
      }
    },
    "/control/v1/projects/{projectId}/quests/{questId}/export": {
      "get": {
        "operationId": "control_quest_export",
        "summary": "Owner/editor экспорт точной immutable draft revision или exact immutable release как deterministic inert .lhquest.zip package",
        "responses": {
          "200": {
            "description": "Successful response"
          }
        }
      }
    },
    "/control/v1/projects/{projectId}/imports": {
      "post": {
        "operationId": "control_imports_create",
        "summary": "Owner/editor bounded fail-closed import .lhquest.zip в новый unpublished quest draft",
        "responses": {
          "201": {
            "description": "Successful response"
          }
        }
      }
    },
    "/control/v1/projects/{projectId}/quests/{questId}/validations": {
      "post": {
        "operationId": "control_validations_create",
        "summary": "Проверка конкретной draft revision участником проекта и фиксация immutable report",
        "responses": {
          "201": {
            "description": "Successful response"
          }
        }
      }
    },
    "/control/v1/projects/{projectId}/quests/{questId}/playtests": {
      "post": {
        "operationId": "control_playtests_create",
        "summary": "Создание frozen playtest участником проекта из проверенного draft snapshot",
        "responses": {
          "201": {
            "description": "Successful response"
          }
        }
      }
    },
    "/control/v1/projects/{projectId}/quests/{questId}/playtests/{playtestId}": {
      "get": {
        "operationId": "control_playtests_get",
        "summary": "Чтение безопасных метаданных frozen playtest доступного проекта",
        "responses": {
          "200": {
            "description": "Successful response"
          }
        }
      }
    },
    "/control/v1/projects/{projectId}/quests/{questId}/playtests/{playtestId}/trace": {
      "get": {
        "operationId": "control_playtests_trace",
        "summary": "Чтение bounded persisted Runtime evidence для exact frozen playtest без replay gameplay и без guest credential/idempotency/fencing данных",
        "responses": {
          "200": {
            "description": "Successful response"
          }
        }
      }
    },
    "/control/v1/projects/{projectId}/quests/{questId}/releases": {
      "get": {
        "operationId": "control_releases_list",
        "summary": "Чтение immutable release summaries, current pointer и publication status участником проекта",
        "responses": {
          "200": {
            "description": "Successful response"
          }
        }
      },
      "post": {
        "operationId": "control_releases_create",
        "summary": "Owner/editor сборка immutable release из точной успешной validation и compiled artifact hash",
        "responses": {
          "201": {
            "description": "Successful response"
          }
        }
      }
    },
    "/control/v1/projects/{projectId}/quests/{questId}/publish": {
      "post": {
        "operationId": "control_publish",
        "summary": "Owner-only атомарная публикация совместимого release через expected-current compare-and-set",
        "responses": {
          "200": {
            "description": "Successful response"
          }
        }
      }
    },
    "/control/v1/projects/{projectId}/quests/{questId}/rollback": {
      "post": {
        "operationId": "control_rollback",
        "summary": "Owner-only pointer rollback к ранее опубликованному release через expected-current compare-and-set",
        "responses": {
          "200": {
            "description": "Successful response"
          }
        }
      }
    },
    "/control/v1/projects/{projectId}/quests/{questId}/draft/proposals/preview": {
      "post": {
        "operationId": "control_authoring_proposals_preview",
        "summary": "Owner/editor server-authoritative validate-on-copy preview typed AuthoringProposal against its exact immutable base revision without draft mutation",
        "responses": {
          "200": {
            "description": "Successful response"
          }
        }
      }
    },
    "/control/v1/projects/{projectId}/quests/{questId}/draft/proposals/apply": {
      "post": {
        "operationId": "control_authoring_proposals_apply",
        "summary": "Owner/editor CSRF/idempotency protected atomic apply of a typed AuthoringProposal only when exact base revision/hash is still current",
        "responses": {
          "201": {
            "description": "Successful response"
          }
        }
      }
    },
    "/control/v1/projects/{projectId}/quests/{questId}/author/jobs": {
      "get": {
        "operationId": "control_author_jobs_list",
        "summary": "Owner/editor discovery of their durable author jobs for one exact project and quest",
        "responses": {
          "200": {
            "description": "Successful response"
          }
        }
      },
      "post": {
        "operationId": "control_author_jobs_create",
        "summary": "Owner/editor CSRF/idempotency protected creation of a bounded durable author job pinned to the current draft snapshot",
        "responses": {
          "201": {
            "description": "Successful response"
          }
        }
      }
    },
    "/control/v1/projects/{projectId}/quests/{questId}/author/jobs/{jobId}": {
      "get": {
        "operationId": "control_author_jobs_get",
        "summary": "Owner/editor read of their persisted author job, factual checkpoints, conversation and durable proposal artifacts",
        "responses": {
          "200": {
            "description": "Successful response"
          }
        }
      }
    },
    "/control/v1/projects/{projectId}/quests/{questId}/author/jobs/{jobId}/segments": {
      "post": {
        "operationId": "control_author_jobs_segments_create",
        "summary": "Owner/editor CSRF/idempotency protected bounded author segment execution with durable replay, pause/resume and no automatic draft mutation",
        "responses": {
          "200": {
            "description": "Successful response"
          }
        }
      }
    },
    "/control/v1/projects/{projectId}/quests/{questId}/author/jobs/{jobId}/cancel": {
      "post": {
        "operationId": "control_author_jobs_cancel",
        "summary": "Owner/editor cancellation of a durable author job including abort of the exact in-flight backend signal and rejection of late output",
        "responses": {
          "200": {
            "description": "Successful response"
          }
        }
      }
    },
    "/control/v1/projects/{projectId}/quests/{questId}/author/jobs/{jobId}/proposals/{proposalId}/apply": {
      "post": {
        "operationId": "control_author_jobs_proposals_apply",
        "summary": "Owner/editor CSRF/idempotency protected apply of the exact server-persisted proposal artifact by jobId and proposalId with durable applied checkpoint",
        "responses": {
          "201": {
            "description": "Successful response"
          }
        }
      }
    }
  }
}
