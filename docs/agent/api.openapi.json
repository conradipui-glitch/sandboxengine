{
  "openapi": "3.1.1",
  "info": {
    "title": "Living History Engine API",
    "version": "0.1.0"
  },
  "paths": {
    "/healthz": {
      "get": {
        "operationId": "runtime_healthz",
        "summary": "Проверка доступности Runtime API",
        "responses": {
          "200": {
            "description": "Successful response"
          }
        }
      }
    },
    "/v1/sessions": {
      "post": {
        "operationId": "runtime_sessions_create",
        "summary": "Создание гостевой игровой сессии",
        "responses": {
          "201": {
            "description": "Successful response"
          }
        }
      }
    },
    "/v1/sessions/{sessionId}": {
      "get": {
        "operationId": "runtime_sessions_get",
        "summary": "Получение player-safe состояния своей игровой сессии",
        "responses": {
          "200": {
            "description": "Successful response"
          }
        }
      }
    },
    "/v1/sessions/{sessionId}/actions": {
      "post": {
        "operationId": "runtime_sessions_action",
        "summary": "Отправка одного поддержанного explicit игрового действия",
        "responses": {
          "200": {
            "description": "Successful response"
          }
        }
      }
    },
    "/v1/sessions/{sessionId}/operations/{operationId}": {
      "get": {
        "operationId": "runtime_operations_get",
        "summary": "Восстановление публичного статуса или результата операции",
        "responses": {
          "200": {
            "description": "Successful response"
          }
        }
      }
    },
    "/control/v1/auth/login": {
      "post": {
        "operationId": "control_auth_login",
        "summary": "Вход закрытого Control-пользователя и выдача серверной сессии с CSRF proof",
        "responses": {
          "200": {
            "description": "Successful response"
          }
        }
      }
    },
    "/control/v1/auth/session": {
      "get": {
        "operationId": "control_auth_session",
        "summary": "Получение безопасных метаданных текущей Control-сессии",
        "responses": {
          "200": {
            "description": "Successful response"
          }
        }
      }
    },
    "/control/v1/auth/logout": {
      "post": {
        "operationId": "control_auth_logout",
        "summary": "CSRF-защищённый отзыв текущей Control-сессии",
        "responses": {
          "200": {
            "description": "Successful response"
          }
        }
      }
    },
    "/control/v1/projects": {
      "get": {
        "operationId": "control_projects_list",
        "summary": "Список доступных текущему автору проектов",
        "responses": {
          "200": {
            "description": "Successful response"
          }
        }
      },
      "post": {
        "operationId": "control_projects_create",
        "summary": "Создание авторского проекта; в authenticated mode создатель атомарно становится owner",
        "responses": {
          "201": {
            "description": "Successful response"
          }
        }
      }
    },
    "/control/v1/projects/{projectId}/members": {
      "get": {
        "operationId": "control_members_list",
        "summary": "Owner-only список участников проекта и ролей",
        "responses": {
          "200": {
            "description": "Successful response"
          }
        }
      }
    },
    "/control/v1/projects/{projectId}/members/{userId}": {
      "put": {
        "operationId": "control_members_update",
        "summary": "Owner-only назначение роли owner/editor/tester существующему закрытому пользователю",
        "responses": {
          "200": {
            "description": "Successful response"
          }
        }
      },
      "delete": {
        "operationId": "control_members_delete",
        "summary": "Owner-only удаление участника с защитой последнего owner",
        "responses": {
          "200": {
            "description": "Successful response"
          }
        }
      }
    },
    "/control/v1/projects/{projectId}/quests": {
      "get": {
        "operationId": "control_quests_list",
        "summary": "Список квестов доступного проекта и текущих draft revisions",
        "responses": {
          "200": {
            "description": "Successful response"
          }
        }
      },
      "post": {
        "operationId": "control_quests_create",
        "summary": "Owner/editor создание квеста с начальным draft snapshot",
        "responses": {
          "201": {
            "description": "Successful response"
          }
        }
      }
    },
    "/control/v1/projects/{projectId}/quests/{questId}/draft": {
      "get": {
        "operationId": "control_draft_get",
        "summary": "Получение текущего авторского draft snapshot доступного проекта",
        "responses": {
          "200": {
            "description": "Successful response"
          }
        }
      }
    },
    "/control/v1/projects/{projectId}/quests/{questId}/draft/changes": {
      "post": {
        "operationId": "control_draft_changes",
        "summary": "Owner/editor атомарное применение change set к указанной draft revision",
        "responses": {
          "200": {
            "description": "Successful response"
          }
        }
      }
    },
    "/control/v1/projects/{projectId}/quests/{questId}/validations": {
      "post": {
        "operationId": "control_validations_create",
        "summary": "Проверка конкретной draft revision участником проекта и фиксация immutable report",
        "responses": {
          "201": {
            "description": "Successful response"
          }
        }
      }
    },
    "/control/v1/projects/{projectId}/quests/{questId}/playtests": {
      "post": {
        "operationId": "control_playtests_create",
        "summary": "Создание frozen playtest участником проекта из проверенного draft snapshot",
        "responses": {
          "201": {
            "description": "Successful response"
          }
        }
      }
    },
    "/control/v1/projects/{projectId}/quests/{questId}/playtests/{playtestId}": {
      "get": {
        "operationId": "control_playtests_get",
        "summary": "Чтение безопасных метаданных frozen playtest доступного проекта",
        "responses": {
          "200": {
            "description": "Successful response"
          }
        }
      }
    },
    "/control/v1/projects/{projectId}/quests/{questId}/releases": {
      "get": {
        "operationId": "control_releases_list",
        "summary": "Чтение immutable release summaries, current pointer и publication status участником проекта",
        "responses": {
          "200": {
            "description": "Successful response"
          }
        }
      },
      "post": {
        "operationId": "control_releases_create",
        "summary": "Owner/editor сборка immutable release из точной успешной validation и compiled artifact hash",
        "responses": {
          "201": {
            "description": "Successful response"
          }
        }
      }
    },
    "/control/v1/projects/{projectId}/quests/{questId}/publish": {
      "post": {
        "operationId": "control_publish",
        "summary": "Owner-only атомарная публикация совместимого release через expected-current compare-and-set",
        "responses": {
          "200": {
            "description": "Successful response"
          }
        }
      }
    },
    "/control/v1/projects/{projectId}/quests/{questId}/rollback": {
      "post": {
        "operationId": "control_rollback",
        "summary": "Owner-only pointer rollback к ранее опубликованному release через expected-current compare-and-set",
        "responses": {
          "200": {
            "description": "Successful response"
          }
        }
      }
    }
  }
}
