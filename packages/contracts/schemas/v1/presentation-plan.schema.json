{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:living-history:schema:presentation-plan:1.0",
  "title": "PresentationPlan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "turnId", "fromRevision", "toRevision", "root"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "id": { "$ref": "#/$defs/id" },
    "turnId": { "$ref": "#/$defs/id" },
    "fromRevision": { "type": "integer", "minimum": 0 },
    "toRevision": { "type": "integer", "minimum": 0 },
    "root": { "$ref": "#/$defs/node" }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "transition": {
      "enum": ["fade", "slide", "crossfade"]
    },
    "node": {
      "oneOf": [
        { "$ref": "#/$defs/sequence" },
        { "$ref": "#/$defs/parallel" },
        { "$ref": "#/$defs/actorShow" },
        { "$ref": "#/$defs/itemShow" },
        { "$ref": "#/$defs/dialogueShow" }
      ]
    },
    "sequence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "children"],
      "properties": {
        "type": { "const": "sequence" },
        "children": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/node" }
        }
      }
    },
    "parallel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "children"],
      "properties": {
        "type": { "const": "parallel" },
        "children": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/node" }
        }
      }
    },
    "actorShow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "actorId", "slot", "transition", "durationMs"],
      "properties": {
        "type": { "const": "actor.show" },
        "actorId": { "$ref": "#/$defs/id" },
        "slot": { "type": "string", "minLength": 1, "maxLength": 100 },
        "transition": { "$ref": "#/$defs/transition" },
        "durationMs": { "type": "integer", "minimum": 0 }
      }
    },
    "itemShow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "assetId", "slot", "transition", "durationMs"],
      "properties": {
        "type": { "const": "item.show" },
        "assetId": { "$ref": "#/$defs/id" },
        "slot": { "type": "string", "minLength": 1, "maxLength": 100 },
        "transition": { "$ref": "#/$defs/transition" },
        "durationMs": { "type": "integer", "minimum": 0 }
      }
    },
    "dialogueShow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "lineId", "reveal"],
      "properties": {
        "type": { "const": "dialogue.show" },
        "lineId": { "$ref": "#/$defs/id" },
        "reveal": { "enum": ["instant", "typewriter"] }
      }
    }
  }
}
