{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:living-history:schema:scheduled-task:1.0",
  "title": "ScheduledTask",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "taskId",
    "sourceId",
    "actorEntityId",
    "startAtElapsedSeconds",
    "completeAtElapsedSeconds",
    "baseOrder",
    "startEffects",
    "completionEffects"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "kind": { "const": "core.task" },
    "taskId": { "type": "string", "minLength": 1, "maxLength": 180 },
    "sourceId": { "$ref": "#/$defs/id" },
    "actorEntityId": { "$ref": "#/$defs/id" },
    "startAtElapsedSeconds": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "completeAtElapsedSeconds": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "baseOrder": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740990
    },
    "startEffects": {
      "type": "array",
      "maxItems": 100,
      "items": { "$ref": "urn:living-history:schema:gameplay-effect:1.0" }
    },
    "completionEffects": {
      "type": "array",
      "maxItems": 100,
      "items": { "$ref": "urn:living-history:schema:gameplay-effect:1.0" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    }
  }
}
