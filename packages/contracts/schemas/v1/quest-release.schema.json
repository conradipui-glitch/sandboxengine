{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:living-history:schema:quest-release:1.0",
  "title": "QuestRelease",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "questId", "releaseId", "title", "compatibility", "blockIds", "entryLocationId"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "questId": { "$ref": "#/$defs/id" },
    "releaseId": { "$ref": "#/$defs/id" },
    "title": { "type": "string", "minLength": 1, "maxLength": 200 },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractsSchemaVersion"],
      "properties": {
        "contractsSchemaVersion": { "const": "1.0" }
      }
    },
    "blockIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "entryLocationId": { "$ref": "#/$defs/id" }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    }
  }
}
