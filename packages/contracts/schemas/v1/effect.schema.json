{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:living-history:schema:effect:1.0",
  "title": "Effect",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "type", "sourceId"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "type": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)+$"
    },
    "sourceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    }
  }
}
