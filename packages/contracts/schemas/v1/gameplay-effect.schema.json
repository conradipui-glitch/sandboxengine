{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:living-history:schema:gameplay-effect:1.0",
  "title": "GameplayEffect",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "type", "sourceId", "entityId", "locationId"],
      "properties": {
        "schemaVersion": { "const": "1.0" },
        "type": { "const": "entity.move" },
        "sourceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "entityId": { "$ref": "#/$defs/id" },
        "locationId": { "$ref": "#/$defs/id" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "type", "sourceId", "itemId", "destination"],
      "properties": {
        "schemaVersion": { "const": "1.0" },
        "type": { "const": "item.transfer" },
        "sourceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "itemId": { "$ref": "#/$defs/id" },
        "destination": { "$ref": "#/$defs/itemPosition" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "type", "sourceId", "resourceId", "delta"],
      "properties": {
        "schemaVersion": { "const": "1.0" },
        "type": { "const": "resource.change" },
        "sourceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "resourceId": { "$ref": "#/$defs/id" },
        "delta": { "type": "integer" }
      }
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "itemPosition": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "locationId"],
          "properties": {
            "kind": { "const": "location" },
            "locationId": { "$ref": "#/$defs/id" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "holderId"],
          "properties": {
            "kind": { "const": "holder" },
            "holderId": { "$ref": "#/$defs/id" }
          }
        }
      ]
    }
  }
}
