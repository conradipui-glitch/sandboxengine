{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:living-history:schema:scene-frame:1.0",
  "title": "SceneFrame",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "sceneId", "revision", "backgroundAssetId", "actors", "items", "overlays", "dialogue", "music"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "sceneId": { "$ref": "#/$defs/id" },
    "revision": { "type": "integer", "minimum": 0 },
    "backgroundAssetId": {
      "anyOf": [
        { "$ref": "#/$defs/id" },
        { "type": "null" }
      ]
    },
    "actors": {
      "type": "array",
      "items": { "$ref": "#/$defs/actor" }
    },
    "items": {
      "type": "array",
      "items": { "$ref": "#/$defs/item" }
    },
    "overlays": {
      "type": "array",
      "items": { "$ref": "#/$defs/overlay" }
    },
    "dialogue": {
      "type": "array",
      "items": { "$ref": "#/$defs/dialogueLine" }
    },
    "music": {
      "anyOf": [
        { "type": "null" },
        { "$ref": "#/$defs/music" }
      ]
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "entityId"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "entityId": { "$ref": "#/$defs/id" },
        "assetId": { "$ref": "#/$defs/id" },
        "slot": { "type": "string", "minLength": 1, "maxLength": 100 },
        "expression": { "type": "string", "minLength": 1, "maxLength": 100 }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "assetId"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "assetId": { "$ref": "#/$defs/id" },
        "slot": { "type": "string", "minLength": 1, "maxLength": 100 }
      }
    },
    "overlay": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "type": "string", "minLength": 1, "maxLength": 100 }
      }
    },
    "dialogueLine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "speakerId", "text"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "speakerId": {
          "anyOf": [
            { "$ref": "#/$defs/id" },
            { "type": "null" }
          ]
        },
        "text": { "type": "string", "minLength": 1, "maxLength": 4000 }
      }
    },
    "music": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assetId"],
      "properties": {
        "assetId": { "$ref": "#/$defs/id" },
        "loop": { "type": "boolean" }
      }
    }
  }
}
