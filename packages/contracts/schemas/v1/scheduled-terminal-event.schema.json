{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:living-history:schema:scheduled-terminal-event:1.0",
  "title": "ScheduledTerminalEvent",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "eventId",
    "atElapsedSeconds",
    "order",
    "sourceId",
    "kind",
    "payload"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "eventId": { "$ref": "#/$defs/id" },
    "atElapsedSeconds": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "order": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "sourceId": { "$ref": "#/$defs/id" },
    "kind": { "const": "core.terminal" },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason", "outcome"],
      "properties": {
        "reason": { "type": "string", "minLength": 1, "maxLength": 200 },
        "outcome": { "type": "string", "minLength": 1, "maxLength": 500 }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    }
  }
}
