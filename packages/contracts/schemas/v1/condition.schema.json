{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:living-history:schema:condition:1.0",
  "title": "Condition",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "type", "resourceId", "value"],
      "properties": {
        "schemaVersion": { "const": "1.0" },
        "type": { "const": "resource.atLeast" },
        "resourceId": { "$ref": "#/$defs/id" },
        "value": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "type", "entityId", "locationId"],
      "properties": {
        "schemaVersion": { "const": "1.0" },
        "type": { "const": "entity.at" },
        "entityId": { "$ref": "#/$defs/id" },
        "locationId": { "$ref": "#/$defs/id" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "type", "itemId", "holderId"],
      "properties": {
        "schemaVersion": { "const": "1.0" },
        "type": { "const": "item.heldBy" },
        "itemId": { "$ref": "#/$defs/id" },
        "holderId": { "$ref": "#/$defs/id" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "type", "conditions"],
      "properties": {
        "schemaVersion": { "const": "1.0" },
        "type": { "const": "all" },
        "conditions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": { "$ref": "#" }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "type", "conditions"],
      "properties": {
        "schemaVersion": { "const": "1.0" },
        "type": { "const": "any" },
        "conditions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": { "$ref": "#" }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "type", "condition"],
      "properties": {
        "schemaVersion": { "const": "1.0" },
        "type": { "const": "not" },
        "condition": { "$ref": "#" }
      }
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    }
  }
}
