{
  "name": "sandboxengine",
  "private": true,
  "version": "0.1.0",
  "description": "Переносимый движок причинных интерактивных историй",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "packageManager": "npm@11.9.0",
  "scripts": {
    "build": "npm run typecheck",
    "typecheck": "tsc -b",
    "test": "npm run test:contracts && npm run test:core && npm run test:storage && npm run test:control && npm run test:server && npm run test:studio && npm run test:player",
    "test:contracts": "npm run typecheck && node --test packages/contracts/test/*.test.mjs",
    "test:core": "npm run typecheck && node --test packages/core/test/*.test.mjs",
    "test:storage": "npm run typecheck && node --test packages/runtime/test/*.test.mjs",
    "test:control": "npm run typecheck && node --test packages/control/test/*.test.mjs",
    "test:server": "npm run typecheck && node --test apps/server/test/*.test.mjs",
    "test:studio": "npm run typecheck && node --test apps/studio/test/*.test.mjs",
    "test:player": "npm run typecheck && node --test packages/player/test/*.test.mjs apps/player/test/*.test.mjs",
    "test:e2e": "npm run test:player",
    "dev:studio": "npm run typecheck && node apps/studio/dist/src/main.js",
    "dev:player": "npm run typecheck && node apps/player/dist/src/main.js",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "docs:generate": "node scripts/docs-generate.mjs",
    "docs:check": "node scripts/docs-check.mjs",
    "verify": "npm run typecheck && npm run test:contracts && npm run test:core && npm run test:storage && npm run test:control && npm run test:server && npm run test:studio && npm run test:player && npm run check:boundaries && npm run docs:check"
  },
  "devDependencies": {
    "ajv": "8.17.1",
    "typescript": "5.9.3"
  }
}
