{
  "name": "sandboxengine",
  "private": true,
  "version": "0.1.0",
  "description": "Переносимый движок причинных интерактивных историй",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "packageManager": "npm@11.9.0",
  "scripts": {
    "build": "npm run typecheck",
    "start": "node apps/server/dist/main.js",
    "typecheck": "tsc -b",
    "test": "npm run test:contracts && npm run test:assets && npm run test:plugins && npm run test:core && npm run test:ai && npm run test:storage && npm run test:control && npm run test:server && npm run test:studio && npm run test:player",
    "test:contracts": "npm run typecheck && node --test packages/contracts/test/*.test.mjs",
    "test:assets": "npm run typecheck && node --test packages/assets/test/*.test.mjs",
    "test:plugins": "npm run typecheck && node --test packages/plugins/test/*.test.mjs",
    "test:core": "npm run typecheck && node --test packages/core/test/*.test.mjs",
    "test:ai": "npm run typecheck && node --test packages/ai/test/*.test.mjs",
    "test:storage": "npm run typecheck && node --test packages/runtime/test/*.test.mjs",
    "test:control": "npm run typecheck && node --test packages/control/test/*.test.mjs",
    "test:server": "npm run typecheck && node --test apps/server/test/*.test.mjs",
    "test:studio": "npm run typecheck && node --test apps/studio/test/*.test.mjs",
    "test:player": "npm run typecheck && node --test packages/player/test/*.test.mjs apps/player/test/*.test.mjs",
    "test:builder": "npm run typecheck && node --test apps/builder-runner/test/*.test.mjs",
    "test:e2e": "npm run test:player",
    "eval:ai": "npm run typecheck && node scripts/eval-ai.mjs",
    "audit:release": "node scripts/b12-release-audit.mjs",
    "migrate:fin01": "npm run typecheck && node scripts/fin01-legacy-migration.mjs",
    "drill:backup-restore": "npm run typecheck && node scripts/b12-backup-restore-drill.mjs",
    "drill:rollback": "npm run typecheck && node scripts/b12-rollback-drill.mjs",
    "drill:startup-shutdown": "npm run typecheck && node scripts/b12-startup-shutdown-drill.mjs",
    "dev:studio": "npm run typecheck && node apps/studio/dist/src/main.js",
    "dev:player": "npm run typecheck && node apps/player/dist/src/main.js",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "docs:generate": "node scripts/docs-generate.mjs",
    "docs:check": "node scripts/docs-check.mjs",
    "verify": "npm run typecheck && npm run audit:release && npm run test:contracts && npm run test:assets && npm run test:plugins && npm run test:core && npm run test:ai && npm run test:storage && npm run drill:backup-restore && npm run drill:rollback && npm run drill:startup-shutdown && npm run test:control && npm run test:server && npm run test:studio && npm run test:player && npm run test:builder && npm run check:boundaries && npm run docs:check"
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "typescript": "5.9.3"
  }
}
