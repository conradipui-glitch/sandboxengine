{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "rootDir": "src",
    "outDir": "dist",
    "paths": {
      "@living-history/contracts": ["../../packages/contracts/src/index.ts"],
      "@living-history/core": ["../../packages/core/src/index.ts"],
      "@living-history/runtime": ["../../packages/runtime/src/index.ts"],
      "@living-history/control": ["../../packages/control/src/index.ts"],
      "@living-history/ai": ["../../packages/ai/src/index.ts"],
      "@living-history/plugins": ["../../packages/plugins/src/index.ts"],
      "@living-history/plugins/execution": ["../../packages/plugins/src/backend-execution.ts"],
      "@living-history/plugins/dice-check": ["../../packages/plugins/src/dice-check.ts"],
      "@living-history/plugins/dice-check-artifact": ["../../packages/plugins/src/dice-check-artifact.ts"],
      "@living-history/plugins/artifact-compatibility": ["../../packages/plugins/src/artifact-compatibility.ts"]
    }
  },
  "references": [
    { "path": "../../packages/contracts" },
    { "path": "../../packages/core" },
    { "path": "../../packages/runtime" },
    { "path": "../../packages/control" },
    { "path": "../../packages/ai" },
    { "path": "../../packages/plugins" }
  ],
  "include": ["src/**/*.ts"]
}
