# Studio (control + studio proxy + player launcher), same node:24.19 image
FROM node:24.19-slim
RUN apt-get update && apt-get install -y --no-install-recommends git python3 make g++ && rm -rf /var/lib/apt/lists/*
WORKDIR /engine
COPY . .
RUN npm ci --include=dev && npm run build && npm prune --omit=dev
ENV NODE_ENV=production LH_STUDIO_PORT=8740 LH_PLAYER_FIXED_PORT=8745
EXPOSE 8740 8745
CMD ["node", "apps/studio/dist/src/main.js"]
