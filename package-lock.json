{
  "name": "sandboxengine",
  "version": "0.1.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "sandboxengine",
      "version": "0.1.0",
      "workspaces": [
        "packages/*"
      ],
      "engines": {
        "node": ">=24.19.0 <25"
      },
      "devDependencies": {
        "typescript": "5.9.3"
      }
    },
    "node_modules/@living-history/contracts": {
      "resolved": "packages/contracts",
      "link": true
    },
    "node_modules/@living-history/core": {
      "resolved": "packages/core",
      "link": true
    },
    "node_modules/typescript": {
      "version": "5.9.3",
      "resolved": "https://registry.npmjs.org/typescript/-/typescript-5.9.3.tgz",
      "dev": true,
      "bin": {
        "tsc": "bin/tsc",
        "tsserver": "bin/tsserver"
      },
      "engines": {
        "node": ">=14.17"
      }
    },
    "packages/contracts": {
      "name": "@living-history/contracts",
      "version": "0.1.0"
    },
    "packages/core": {
      "name": "@living-history/core",
      "version": "0.1.0",
      "dependencies": {
        "@living-history/contracts": "0.1.0"
      }
    }
  }
}

